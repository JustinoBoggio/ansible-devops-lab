# .ansible-lint configuration

profile: min  # We use the minimal profile to start with a clean slate and only add the rules we care about.

# Files to ignore
exclude_paths:
  - .github/
  - roles/geerlingguy.git/
  - .vault_pass

# Rules to skip
skip_list:
  - "fqcn"              # Ignore full name (ej: ansible.builtin.copy)
  - "var-naming"        # Ignore variable naming conventions
  - "no-changed-when"   # Ignore shell command warnings
  - "yaml"              # Ignore spacing, newlines and yes/no
  - "role-name"         # Ignore role name conventions
  - "risky-file-permissions" # Ignore permissions in get_url
  - "meta-incorrect"    # Ignore author/license metadata
  - "ignore-errors"     # Allow using ignore_errors: yes
  - "name[casing]"      # Ignore uppercase in task names
  - "schema[meta]"      # Ignore strict validation of meta/main.yml
